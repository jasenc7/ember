    "terminal.ansiBrightCyan": "{{bright_cyan}}",
    "terminal.ansiBrightWhite": "{{bright_white}}"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "{{muted}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other.directive"
      ],
      "settings": {
        "foreground": "{{ember}}"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "{{muted}}"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "{{sage}}"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "{{peach}}"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "{{gold}}"
      }
    },
    {
      "name": "Types and constructors",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "{{orchid}}"
      }
    },
    {
      "name": "Constants, numbers and booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "{{peach}}"
      }
    },
    {
      "name": "Variables and properties",
      "scope": [
        "variable",
        "meta.object-literal.key",
        "support.variable"
      ],
      "settings": {
        "foreground": "{{text}}"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "{{text}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Special variables",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "{{ember}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Attributes and decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "{{gold}}"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "{{ember}}"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "{{muted}}"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "{{sky}}"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "{{text}}"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "{{ember}}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "{{sage}}"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline.markdown"
      ],
      "settings": {
        "foreground": "{{sky}}"
      }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "{{ember}}"
      }
    },
    {
      "name": "Inserted content",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "{{sage}}"
      }
    },
    {
      "name": "Deleted content",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "{{ember}}"
      }
    },
    {
      "name": "Changed content",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "{{gold}}"
      }
    },
    {
      "name": "Invalid tokens",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "{{ember}}"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "{{orchid}}",
    "type": "{{orchid}}",
    "class": "{{orchid}}",
    "enum": "{{orchid}}",
    "interface": "{{orchid}}",
    "struct": "{{orchid}}",
    "typeParameter": "{{orchid}}",
    "function": "{{gold}}",
    "method": "{{gold}}",
    "decorator": "{{gold}}",
    "macro": "{{ember}}",
    "keyword": "{{ember}}",
    "modifier": "{{ember}}",
    "variable": "{{text}}",
    "property": "{{text}}",
    "enumMember": "{{peach}}",
    "variable.readonly": "{{peach}}",
    "property.readonly": "{{peach}}",
    "number": "{{peach}}",
    "string": "{{sage}}",
    "regexp": "{{peach}}",
    "operator": "{{muted}}",
    "parameter": {
      "foreground": "{{text}}",
      "italic": true
    },
    "comment": {
      "foreground": "{{muted}}",
      "italic": true
    }
  }
}
