    "terminal.ansiYellow": "#e8a682",
    "terminal.ansiBlue": "#6fbcd4",
    "terminal.ansiMagenta": "#b080cc",
    "terminal.ansiCyan": "#6fbcd4",
    "terminal.ansiWhite": "#e0dbd5",
    "terminal.ansiBrightBlack": "#8a8588",
    "terminal.ansiBrightRed": "#e8a682",
    "terminal.ansiBrightGreen": "#5faa9e",
    "terminal.ansiBrightYellow": "#dbb45a",
    "terminal.ansiBrightBlue": "#6fbcd4",
    "terminal.ansiBrightMagenta": "#b080cc",
    "terminal.ansiBrightCyan": "#6fbcd4",
    "terminal.ansiBrightWhite": "#eee9e3"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8a8588",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other.directive"
      ],
      "settings": {
        "foreground": "#dc9472"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#8a8588"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#5faa9e"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#e8a682"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#dbb45a"
      }
    },
    {
      "name": "Types and constructors",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#b080cc"
      }
    },
    {
      "name": "Constants, numbers and booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#e8a682"
      }
    },
    {
      "name": "Variables and properties",
      "scope": [
        "variable",
        "meta.object-literal.key",
        "support.variable"
      ],
      "settings": {
        "foreground": "#e0dbd5"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e0dbd5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Special variables",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#dc9472",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Attributes and decorators",
      "scope": [
        "entity.other.attribute-name",
        "meta.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#dbb45a"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#dc9472"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#8a8588"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#6fbcd4"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#e0dbd5"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#dc9472",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#5faa9e"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline.markdown"
      ],
      "settings": {
        "foreground": "#6fbcd4"
      }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#dc9472"
      }
    },
    {
      "name": "Inserted content",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#5faa9e"
      }
    },
    {
      "name": "Deleted content",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#dc9472"
      }
    },
    {
      "name": "Changed content",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#dbb45a"
      }
    },
    {
      "name": "Invalid tokens",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#dc9472"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#b080cc",
    "type": "#b080cc",
    "class": "#b080cc",
    "enum": "#b080cc",
    "interface": "#b080cc",
    "struct": "#b080cc",
    "typeParameter": "#b080cc",
    "function": "#dbb45a",
    "method": "#dbb45a",
    "decorator": "#dbb45a",
    "macro": "#dc9472",
    "keyword": "#dc9472",
    "modifier": "#dc9472",
    "variable": "#e0dbd5",
    "property": "#e0dbd5",
    "enumMember": "#e8a682",
    "variable.readonly": "#e8a682",
    "property.readonly": "#e8a682",
    "number": "#e8a682",
    "string": "#5faa9e",
    "regexp": "#e8a682",
    "operator": "#8a8588",
    "parameter": {
      "foreground": "#e0dbd5",
      "italic": true
    },
    "comment": {
      "foreground": "#8a8588",
      "italic": true
    }
  }
}
